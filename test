<template if:true={showLinkModal}>

    <section
        class="slds-modal slds-fade-in-open"
        role="dialog">

        <div class="slds-modal__container">

            <header class="slds-modal__header">
                <h2 class="slds-text-heading_medium">
                    Link Opportunities
                </h2>
            </header>

            <div class="slds-modal__content slds-p-around_medium">

                <lightning-radio-group
                    name="groupOption"
                    label="Group Option"
                    options={groupOptions}
                    value={groupMode}
                    onchange={handleGroupModeChange}>
                </lightning-radio-group>

                <!-- EXISTING GROUP -->

                <template if:false={isCreateNewGroup}>

                    <lightning-input
                        label="Search Existing Group"
                        value={searchKey}
                        onchange={handleSearch}>
                    </lightning-input>

                    <template if:true={showSearchResults}>

                        <div
                            class="slds-box slds-scrollable_y"
                            style="max-height:200px">

                            <template
                                for:each={groupResults}
                                for:item="group">

                                <div
                                    key={group.Id}
                                    class="slds-p-around_x-small
                                           slds-border_bottom"
                                    data-id={group.Id}
                                    data-name={group.Group_Name__c}
                                    onclick={selectGroup}>

                                    {group.Group_Name__c}

                                </div>

                            </template>

                        </div>

                    </template>

                </template>

                <!-- NEW GROUP -->

                <template if:true={isCreateNewGroup}>

                    <lightning-input
                        label="New Group Name"
                        value={newGroupName}
                        onchange={handleNewGroupName}>
                    </lightning-input>

                </template>

            </div>

            <footer class="slds-modal__footer">

                <lightning-button
                    label="Cancel"
                    onclick={closeLinkModal}>
                </lightning-button>

                <lightning-button
                    variant="brand"
                    label="Save"
                    onclick={saveLink}>
                </lightning-button>

            </footer>

        </div>

    </section>

    <div class="slds-backdrop slds-backdrop_open"></div>

</template>

