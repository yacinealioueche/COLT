public with sharing class RecordGroupController {

    @AuraEnabled(cacheable=true)
    public static List<XLP_Record_Group__c> searchGroups(
        String searchTerm,
        List<Id> opportunityIds
    ) {

        if(String.isBlank(searchTerm)
            || opportunityIds == null
            || opportunityIds.isEmpty()) {

            return new List<XLP_Record_Group__c>();
        }

        Opportunity sampleOpp = [

            SELECT XLP_ClientName__c

            FROM Opportunity

            WHERE Id IN :opportunityIds

            LIMIT 1
        ];

        Id accountId = sampleOpp.XLP_ClientName__c;

        return [

            SELECT Id,
                   Group_Name__c

            FROM XLP_Record_Group__c

            WHERE Account__c = :accountId

            AND Group_Name__c LIKE :('%' + searchTerm + '%')

            ORDER BY Group_Name__c

            LIMIT 20
        ];
    }
}
