import { LightningElement, track } from 'lwc';

import searchGroups
    from '@salesforce/apex/RecordGroupController.searchGroups';

showLinkModal = false;

selectedIds = [];

groupMode = 'existing';

searchKey = '';

newGroupName = '';

groupResults = [];

selectedGroupId;

selectedGroupName;

showSearchResults = false;

groupOptions = [
    {
        label: 'Existing Group',
        value: 'existing'
    },
    {
        label: 'New Group',
        value: 'new'
    }
];

get isCreateNewGroup() {
return this.groupMode === 'new';
}

handleGroupModeChange(event) {

    this.groupMode =
        event.detail.value;
}

handleSearch(event) {

    this.searchKey =
        event.target.value;

    if(!this.searchKey ||
       this.searchKey.length < 2) {

        this.groupResults = [];

        this.showSearchResults = false;

        return;
    }

    searchGroups({

        searchTerm: this.searchKey,

        opportunityIds: this.selectedIds

    })
    .then(result => {

        this.groupResults = result;

        this.showSearchResults =
            result.length > 0;
    })
    .catch(error => {

        console.error(error);
    });
}

selectGroup(event) {

    this.selectedGroupId =
        event.currentTarget.dataset.id;

    this.selectedGroupName =
        event.currentTarget.dataset.name;

    this.searchKey =
        this.selectedGroupName;

    this.showSearchResults = false;
}

handleNewGroupName(event) {

    this.newGroupName =
        event.target.value;
}

saveLink() {

